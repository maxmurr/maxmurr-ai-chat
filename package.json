{
  "name": "maxmurr-ai-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "next start",
    "lint": "bun --bun eslint",
    "lint:boundaries": "depcruise app components di drizzle e2e features hooks lib src test",
    "test": "bun test",
    "test:e2e": "INSTANT_E2E=1 playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:reset": "bun -e \"import postgres from 'postgres'; if (prompt('Type RESET to wipe database: ') !== 'RESET') process.exit(1); const sql = postgres(process.env.POSTGRES_URL!); await sql.unsafe('DROP SCHEMA IF EXISTS drizzle CASCADE; DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public').simple(); await sql.end()\" && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.82",
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "1.7.1",
    "@evyweb/ioctopus": "^1.4.1",
    "@mastra/ai-sdk": "1.9.1",
    "@mastra/core": "1.61.0",
    "@mastra/langfuse": "1.5.0",
    "@mastra/observability": "1.17.1",
    "@next/env": "16.3.3",
    "@sentry/nextjs": "10.72.0",
    "@shadcn/react": "^0.3.0",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-form": "1.33.5",
    "ai": "7.0.79",
    "better-auth": "1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-email": "6.9.3",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.10.1",
    "resend": "6.24.0",
    "server-only": "0.0.1",
    "shadcn": "^4.19.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@next/playwright": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-boundaries": "^7.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "bun@1.4.0",
